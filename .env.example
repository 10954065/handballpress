# Copy to .env.local for development. Never commit real values.

# --- Database (PostgreSQL via Neon, provisioned through the Vercel Marketplace) ---
# Pooled connection, used by the Prisma Client adapter at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/handball_press_gh"
# Direct/unpooled connection, used by the Prisma CLI for migrations
# (Neon's pgbouncer pooling doesn't support Migrate's advisory locks).
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/handball_press_gh"

# --- Auth ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# --- Object storage / CDN (media library) ---
# Vercel Blob is the default target; swap provider if that decision changes.
BLOB_READ_WRITE_TOKEN=""

# --- Email (transactional: newsletter, password reset, contact form) ---
RESEND_API_KEY=""
EMAIL_FROM="Hand Ball Press GH <news@handballpressgh.com>"

# --- Initial admin seed (prisma/seed.ts, run once via `npm run db:seed`) ---
# Leave unset to skip seeding. Password must be 12+ characters.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics (optional, wire up when available) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# --- WordPress migration source (read-only, never mutated) ---
WORDPRESS_SITE_URL="https://handballpressgh.wordpress.com"

# --- Cron (scheduled article publishing safety net) ---
# Vercel sends this as `Authorization: Bearer <value>` on cron invocations.
# Generate with: openssl rand -hex 16
CRON_SECRET=""
